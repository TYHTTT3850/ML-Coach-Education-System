# 运行环境：development、test 或 production；生产环境会启用更严格的安全校验。
APP_ENV=development
# FastAPI 监听地址；0.0.0.0 允许局域网或容器访问。
APP_HOST=0.0.0.0
# FastAPI 监听端口，范围为 1 到 65535。
APP_PORT=8000
# 应用日志级别，例如 DEBUG、INFO、WARNING 或 ERROR。
APP_LOG_LEVEL=INFO

# 允许跨域访问 API 的前端地址；多个地址使用英文逗号分隔。
FRONTEND_ORIGIN=http://localhost:3000
# “知识库”页面的管理员凭证，用于上传、删除和管理课程资料；生产环境必须替换为高强度随机值。
ADMIN_TOKEN=change-this-admin-token

# LLM 厂商、端点、模型与 API 密钥由每位用户在设置页填写。
# LLM 采样温度，0 更稳定，较高值更有发散性，取值范围为 0 到 2。
LLM_TEMPERATURE=0.2
# 单次 LLM 请求的最长等待时间，单位为秒。
LLM_TIMEOUT_SECONDS=60

# Embedding 端点、模型与 API 密钥由每位用户在设置页填写。
# 向量维度；留空时由服务端响应自动推断。
EMBEDDING_DIMENSION=

# pgvector 距离度量：cosine、l2 或 ip。
VECTOR_DISTANCE_METRIC=cosine
# PostgreSQL 连接串；请替换账号、密码、主机、端口和数据库名。
# PostgreSQL 连接字符串的标准格式如下：
# postgresql://[用户名]:[密码]@[主机]:[端口]/[数据库名]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ml_coach
# 接收用户上传原始文件的本地目录。
UPLOAD_PATH=./data/uploads

# 每次 RAG 检索返回的候选片段数，范围为 1 到 50。
RAG_TOP_K=6
# 是否只依据检索到的资料回答；true 可减少无依据回答。
RAG_STRICT_MODE=true
# 是否启用 HyDE 假设文档扩展检索。
RAG_HYDE_ENABLED=true
# 检索距离阈值；留空表示不额外过滤结果。
RAG_DISTANCE_THRESHOLD=0.8
# 文档切分块大小，单位为字符。
CHUNK_SIZE=800
# 相邻文本块的重叠字符数，必须小于 CHUNK_SIZE。
CHUNK_OVERLAP=120
# 单个上传文件允许的最大体积，单位为 MB。
MAX_UPLOAD_MB=20
# 单次对话保留的历史消息数。
MAX_HISTORY_MESSAGES=12
# 单条用户消息允许的最大字符数。
MAX_MESSAGE_LENGTH=8000

# 默认练习集题目数量。
PRACTICE_DEFAULT_COUNT=3
# 默认关卡测验题目数量。
CHECKPOINT_DEFAULT_COUNT=5
# 单个练习集允许的最大题目数量，同时限定上述两个默认值。
PRACTICE_MAX_COUNT=8

# 判定主题掌握的最低掌握度，取值范围为 0 到 1。
MASTERY_GATE_THRESHOLD=0.80
# 解锁依赖主题所需的最低掌握度，取值范围为 0 到 1。
PREREQUISITE_MASTERY_THRESHOLD=0.80
# 达到掌握状态所需的最少有效作答次数。
MASTERY_MIN_VALID_ATTEMPTS=3
# 关卡测验达到掌握要求的最低分数，取值范围为 0 到 100。
MASTERY_CHECKPOINT_SCORE=80
# 掌握判定要求覆盖的最少能力维度数。
MASTERY_MIN_DIMENSION_COVERAGE=3
# 掌握度证据累积达到可信状态所需的目标值。
MASTERY_EVIDENCE_CONFIDENCE_TARGET=6

# 低于此置信度的评价会持久化为 evaluation_uncertain，但不会更新 Beta。
# 评价结果可用于更新掌握度的最低置信度，取值范围为 0 到 1。
EVALUATOR_MIN_CONFIDENCE=0.60
# 结构化评价结果校正失败后允许的最大重试次数。
EVALUATION_MAX_REPAIR_ATTEMPTS=1

# 练习题生成任务的 LLM 采样温度。
PRACTICE_GENERATION_TEMPERATURE=0.30
# 答案评价任务的 LLM 采样温度；建议保持为 0 以获得稳定结果。
EVALUATION_TEMPERATURE=0.00
# 补救学习建议生成任务的 LLM 采样温度。
REMEDIATION_TEMPERATURE=0.20

# 生成新题时用于去重的近期题目数量。
RECENT_QUESTION_DEDUP_COUNT=10
# 题目生成不符合结构或质量要求时允许的最大重试次数。
QUESTION_GENERATION_MAX_RETRIES=1
